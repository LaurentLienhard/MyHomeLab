# ============================================================================
# Environment Variables Template - Pour Terraform
# ============================================================================
#
# Deux options pour fournir les variables:
#
# OPTION 1: Ce fichier (recommandé pour développement local)
# - Copier: cp .env.template .env.local
# - Éditer: vim .env.local
# - Sourcer: source .env.local
# - IMPORTANT: Ne JAMAIS committer .env.local à git!
#
# OPTION 2: Variables d'environnement directes (recommandé pour CI/CD)
# - export TF_VAR_proxmox_url="..."
# - export TF_VAR_proxmox_api_token="..."
#
# ============================================================================

# URL API Proxmox (OBLIGATOIRE)
export TF_VAR_proxmox_url="https://pve1.homelab.local:8006"

# Token API Proxmox (OBLIGATOIRE - SENSIBLE!)
# Format: user@realm!tokenname=uuid
# Obtenir via: Proxmox UI → Datacenter → Permissions → API Tokens
export TF_VAR_proxmox_api_token="root@pam!terraform=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Mode insécurisé (accepter certificats auto-signés)
export TF_VAR_proxmox_insecure="true"

# Utilisateur SSH
export TF_VAR_ssh_username="root"

# Nœud Proxmox
export TF_VAR_proxmox_node_name="pve1"

# Cluster Proxmox
export TF_VAR_proxmox_cluster_name="homelab-cluster"

# Environnement
export TF_VAR_environment="homelab"

# ============================================================================
# Variables Optionnelles (à remplir plus tard)
# ============================================================================

# NFS Server IP (optionnel)
# export TF_VAR_nfs_server_ip="192.168.1.252"

# Backup Email (optionnel)
# export TF_VAR_backup_email="admin@example.com"

# ============================================================================
# Configuration Terraform Optionnelle
# ============================================================================

# Activer debug logging (DEBUG, INFO, WARN, ERROR)
# export TF_LOG="WARN"

# Chemin vers le fichier de plan
# export TF_PLAN_FILE="tfplan"

