# ============================================================================
# EXEMPLES DE RESSOURCES
# ============================================================================
#
# Ce fichier contient des exemples de ressources que vous pouvez ajouter
# progressivement. Ces exemples sont COMMENTÉS - à décommenter au besoin.
#
# Pour utiliser: Copier le code pertinent dans main.tf et adapter
#
# ============================================================================

# ============================================================================
# Phase 2: Stockage NFS
# ============================================================================
#
# Prérequis:
# - variable "nfs_server_ip" = "192.168.1.252"
# - variable "nfs_export_base" = "/volume1"
# - Exports NFS existants sur le NAS
#

# resource "proxmox_virtual_environment_storage" "nfs_iso" {
#   datastore_id = "nas-iso"
#   type         = "nfs"
#   content      = ["iso"]
#   nodes        = [var.proxmox_node_name]
#   disable      = false
#
#   nfs {
#     server = var.nfs_server_ip
#     export = "${var.nfs_export_base}/nas-iso"
#   }
# }
#
# resource "proxmox_virtual_environment_storage" "nfs_backup" {
#   datastore_id = "nas-backup"
#   type         = "nfs"
#   content      = ["backup"]
#   nodes        = [var.proxmox_node_name]
#   disable      = false
#
#   nfs {
#     server = var.nfs_server_ip
#     export = "${var.nfs_export_base}/nas-backup"
#   }
# }
#
# resource "proxmox_virtual_environment_storage" "nfs_template" {
#   datastore_id = "nas-template"
#   type         = "nfs"
#   content      = ["images", "rootdir"]
#   nodes        = [var.proxmox_node_name]
#   disable      = false
#
#   nfs {
#     server = var.nfs_server_ip
#     export = "${var.nfs_export_base}/nas-template"
#   }
# }

# ============================================================================
# Phase 3: Sauvegardes Automatiques
# ============================================================================
#
# Prérequis:
# - Phase 2 (Stockage NFS) complétée
# - Accès au stockage nas-backup
#

# resource "proxmox_virtual_environment_backup_job" "daily" {
#   schedule = "0 21 * * *"  # 21:00 tous les jours
#   nodes    = [var.proxmox_node_name]
#   storage  = "nas-backup"
#
#   retention {
#     keep_daily   = 7
#     keep_monthly = 1
#   }
#
#   compression = "zstd"
#   enabled     = true
#   comment     = "Daily backups managed by Terraform"
#
#   depends_on = [
#     proxmox_virtual_environment_storage.nfs_backup
#   ]
# }

# ============================================================================
# Phase 4: Certificat SSL Custom
# ============================================================================
#
# Prérequis:
# - Certificat SSL valide (PEM format)
# - Clé privée (PEM format)
#
# Fichiers attendus:
# - HomeLab/terrafrom/certs/cert.pem
# - HomeLab/terrafrom/certs/key.pem
#

# resource "proxmox_virtual_environment_certificate" "custom" {
#   node_name    = var.proxmox_node_name
#   certificate  = file("${path.module}/certs/cert.pem")
#   private_key  = file("${path.module}/certs/key.pem")
#   force        = true  # ⚠️ Remplace le certificat existant!
# }

