# ============================================================================
# Phase 6: Simple Linux VM (basée sur template)
# ============================================================================
#
# Prérequis:
# - Template Linux existant (VM ID: 9000)
# - Réseau vlan0 avec bridge vmbr0
#

# resource "proxmox_virtual_environment_vm" "linux_example" {
#   node_name    = var.proxmox_node_name
#   vm_id        = 100
#   name         = "linux-01"
#   description  = "Linux VM managed by Terraform"
#   startup {
#     order      = "any"
#   }
#
#   initialization {
#     user_account {
#       username = "ubuntu"
#       password = "changeme"  # À changer!
#     }
#
#     dns {
#       servers = ["8.8.8.8", "8.8.4.4"]
#     }
#   }
#
#   cpu {
#     cores = 2
#     type  = "x86-64-v2-AES"
#   }
#
#   memory {
#     dedicated = 2048  # 2GB
#   }
#
#   network_device {
#     bridge = "vmbr0"
#   }
#
#   clone {
#     vm_id = 9000  # ID du template Linux
#   }
# }

